{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": false
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": false,
        "WP_DEBUG_LOG": true,
        "SCRIPT_DEBUG": true
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "solseo/solseo.php"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/review-tools/probe-widget.php';"
    }
  ]
}
